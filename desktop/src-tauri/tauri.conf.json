{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimohodom",
  "version": "0.10.0",
  "identifier": "app.fastnotes.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Мимоходом",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Быстрые заметки с синхронизацией с телефоном",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
